<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#080808">
    <ImageView android:id="@+id/backdrop" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:alpha="0.15"/>
    <View android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/gradient_overlay"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="32dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/clock" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="12:30 WIB" android:textSize="32sp" android:textColor="#FFFFFF"/>
                <TextView android:id="@+id/date" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Jakarta" android:textSize="13sp" android:textColor="#FFF" android:alpha="0.8"/>
                <TextView android:id="@+id/weather" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Live Backdrop ON" android:textSize="12sp" android:textColor="#FFD700" android:layout_marginTop="4dp"/>
            </LinearLayout>
            <TextView android:id="@+id/prayer" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Prayer Jakarta" android:textSize="11sp" android:textColor="#FFD700" android:background="#22FFD700" android:padding="8dp"/>
        </LinearLayout>
        <TextView android:id="@+id/now_playing" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="NOW PLAYING" android:textSize="14sp" android:textColor="#000000" android:background="#FFD700" android:padding="8dp" android:layout_marginTop="12dp" android:visibility="gone"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:gravity="bottom" android:layout_marginBottom="16dp">
            <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="CouchLight Indonesia Live" android:textSize="26sp" android:textColor="#FFFFFF"/>
            <TextView android:id="@+id/desc" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Backdrop dari apa yang lagi diputar" android:textSize="13sp" android:textColor="#FFF" android:alpha="0.7" android:maxLines="2" android:layout_marginTop="6dp"/>
        </LinearLayout>
        <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none">
            <LinearLayout android:id="@+id/app_row" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal"/>
        </HorizontalScrollView>
    </LinearLayout>
</RelativeLayout>
